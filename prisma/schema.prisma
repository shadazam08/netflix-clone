generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url  	    = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

enum ProfileType {
  ADULT
  KIDS
}
enum ContentType {
  MOVIE
  TV_SHOW
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  INACTIVE
}

enum ContentVisibility {
  PUBLIC
  PREMIUM
}

enum Certification {
  U
  UA7
  UA13
  UA16
  A
}
enum LanguageCode {
  EN
  HI
  TA
  TE
  ML
  KN
  BN
  MR
  GU
  PA
}

enum MediaType {
  POSTER
  BANNER
  LOGO
  THUMBNAIL
  TRAILER
  VIDEO
}

enum SubtitleFormat {
  VTT
  SRT
}

enum AudioType {
  ORIGINAL
  DUBBED
}
enum PersonRole {
  ACTOR
  DIRECTOR
  PRODUCER
  WRITER
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?

  users       User[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id              String      @id @default(cuid())
  email           String      @unique
  password        String
  emailVerifiedAt DateTime?
  status          UserStatus  @default(PENDING)

  roleId          String
  role            Role        @relation(fields: [roleId], references: [id])

  profiles        Profile[]
  accounts Account[]
  sessions Session[]

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Profile {
  id          String      @id @default(cuid())
  name        String
  avatar      String?
  pin         String?
  type        ProfileType @default(ADULT)
  language    String      @default("en")

  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String

  refresh_token String?
  access_token  String?
  expires_at    Int?
  token_type    String?
  scope         String?
  id_token      String?
  session_state String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
model Content {
  id              String              @id @default(cuid())

  title           String
  slug            String              @unique

  description     String              @db.Text

  type            ContentType
  status          ContentStatus       @default(DRAFT)
  visibility      ContentVisibility   @default(PUBLIC)

  certification   Certification

  releaseDate     DateTime?

  duration        Int?

  isFeatured      Boolean             @default(false)
  isTrending      Boolean             @default(false)

  categoryLinks   ContentCategory[]
  genreLinks      ContentGenre[]

  movie           Movie?
  tvShow          TvShow?

  languages   ContentLanguage[]
  media       Media[]
  subtitles   Subtitle[]
  audioTracks AudioTrack[]
  people      ContentPerson[]

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([slug])
  @@index([status])
  @@index([type])
}

model Movie {
  id          String   @id @default(cuid())

  contentId   String   @unique
  content     Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TvShow {
  id          String   @id @default(cuid())

  contentId   String   @unique
  content     Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  seasons     Season[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Season {
  id          String   @id @default(cuid())

  tvShowId    String
  tvShow      TvShow   @relation(fields: [tvShowId], references: [id], onDelete: Cascade)

  seasonNo    Int
  title       String

  episodes    Episode[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tvShowId, seasonNo])
}

model Episode {
  id          String   @id @default(cuid())

  seasonId    String
  season      Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  episodeNo   Int
  title       String

  duration    Int?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([seasonId, episodeNo])
}

model Category {
  id          String   @id @default(cuid())

  name        String   @unique
  slug        String   @unique

  contents    ContentCategory[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Genre {
  id          String   @id @default(cuid())

  name        String   @unique
  slug        String   @unique

  contents    ContentGenre[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ContentCategory {
  contentId   String
  categoryId  String

  content      Content   @relation(fields: [contentId], references: [id], onDelete: Cascade)
  category     Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([contentId, categoryId])
}

model ContentGenre {
  contentId   String
  genreId     String

  content     Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  genre       Genre   @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([contentId, genreId])
}
model Language {
  id        String   @id @default(cuid())
  name      String
  code      LanguageCode @unique

  contents  ContentLanguage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContentLanguage {
  contentId  String
  languageId String

  content    Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  language   Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@id([contentId, languageId])
}

model Media {
  id          String    @id @default(cuid())

  contentId   String
  content     Content   @relation(fields: [contentId], references: [id], onDelete: Cascade)

  type        MediaType

  url         String
  publicId    String?

  width       Int?
  height      Int?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([contentId])
  @@index([type])
}

model Subtitle {
  id          String   @id @default(cuid())

  contentId   String
  content     Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  language    LanguageCode

  format      SubtitleFormat

  url         String

  createdAt   DateTime @default(now())
}

model AudioTrack {
  id          String   @id @default(cuid())

  contentId   String
  content     Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  language    LanguageCode

  type        AudioType

  url         String

  createdAt   DateTime @default(now())
}
model Person {
  id          String   @id @default(cuid())

  name        String
  slug        String   @unique

  biography   String?  @db.Text

  profileImage String?

  isActive    Boolean  @default(true)

  contents    ContentPerson[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
}

model ContentPerson {
  contentId   String
  personId    String

  role         PersonRole
  displayOrder Int       @default(0)

  content      Content   @relation(fields: [contentId], references: [id], onDelete: Cascade)
  person       Person    @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([contentId, personId, role])
  @@index([personId])
}