generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ContentType {
  MOVIE
  TV_SHOW
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContentVisibility {
  PUBLIC
  PRIVATE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum CrewRole {
  DIRECTOR
  WRITER
  PRODUCER
  EXECUTIVE_PRODUCER
  SCREENPLAY
  STORY
  DIALOGUE
  MUSIC_DIRECTOR
  SINGER
  LYRICIST
  EDITOR
  CINEMATOGRAPHER
  CHOREOGRAPHER
  VFX_SUPERVISOR
  COSTUME_DESIGNER
  MAKEUP_ARTIST
}

enum VideoQuality {
  P240
  P360
  P480
  P720
  P1080
  P1440
  P2160
}

enum NotificationType {
  SYSTEM
  NEW_CONTENT
  ACCOUNT
}

model User {
  id       String     @id @default(cuid())
  name     String
  email    String     @unique
  password String?
  role     UserRole   @default(USER)
  status   UserStatus @default(ACTIVE)

  avatar        String?
  emailVerified DateTime?
  lastLoginAt   DateTime?

  accounts Account[]
  sessions Session[]

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  watchHistory     WatchHistory[]
  continueWatching ContinueWatching[]
  myList           MyList[]
  ratings          Rating[]
  reviews          Review[]
  notifications    Notification[]
  auditLogs        AuditLog[]
}

model Account {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type              String
  provider          String
  providerAccountId String

  refresh_token String? @db.Text
  access_token  String? @db.Text
  expires_at    Int?
  token_type    String?
  scope         String?
  id_token      String? @db.Text
  session_state String?

  @@unique([provider, providerAccountId])
}

model Session {
  id String @id @default(cuid())

  sessionToken String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expires DateTime
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Genre {
  id          String         @id @default(cuid())
  name        String         @unique
  slug        String         @unique
  description String?
  contents    ContentGenre[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model Category {
  id          String            @id @default(cuid())
  name        String            @unique
  slug        String            @unique
  description String?
  contents    ContentCategory[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model Language {
  id          String            @id @default(cuid())
  name        String            @unique
  code        String            @unique
  contents    ContentLanguage[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  audioTracks AudioTrack[]
  subtitles   Subtitle[]
}

model Country {
  id        String           @id @default(cuid())
  name      String           @unique
  code      String           @unique
  contents  ContentCountry[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model Content {
  id String @id @default(cuid())

  title String
  slug  String @unique

  type ContentType

  status     ContentStatus     @default(DRAFT)
  visibility ContentVisibility @default(PUBLIC)

  shortDescription String?
  description      String? @db.Text

  releaseDate DateTime?

  duration Int?

  ageRating String?

  poster          String?
  banner          String?
  thumbnail       String?
  trailer         String?
  metaTitle       String?
  metaDescription String?

  isFeatured Boolean @default(false)
  isTrending Boolean @default(false)

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  genres           ContentGenre[]
  categories       ContentCategory[]
  languages        ContentLanguage[]
  countries        ContentCountry[]
  cast             ContentCast[]
  crew             ContentCrew[]
  videos           Video[]
  audioTracks      AudioTrack[]
  subtitles        Subtitle[]
  images           Image[]
  seasons          Season[]
  watchHistory     WatchHistory[]
  continueWatching ContinueWatching[]
  myList           MyList[]
  ratings          Rating[]
  reviews          Review[]
}

model ContentGenre {
  id String @id @default(cuid())

  contentId String
  genreId   String

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  genre   Genre   @relation(fields: [genreId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([contentId, genreId])
  @@index([contentId])
  @@index([genreId])
}

model ContentCategory {
  id String @id @default(cuid())

  contentId  String
  categoryId String

  content  Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([contentId, categoryId])
  @@index([contentId])
  @@index([categoryId])
}

model ContentLanguage {
  id String @id @default(cuid())

  contentId  String
  languageId String

  content  Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([contentId, languageId])
  @@index([contentId])
  @@index([languageId])
}

model ContentCountry {
  id String @id @default(cuid())

  contentId String
  countryId String

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([contentId, countryId])
  @@index([contentId])
  @@index([countryId])
}

model Person {
  id String @id @default(cuid())

  name String
  slug String @unique

  biography String? @db.Text

  dateOfBirth DateTime?
  dateOfDeath DateTime?

  gender Gender?

  nationality String?

  profileImage String?

  cast ContentCast[]
  crew ContentCrew[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContentCast {
  id String @id @default(cuid())

  contentId String
  personId  String

  characterName String

  castOrder Int

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  person  Person  @relation(fields: [personId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contentId, personId])
  @@index([contentId])
  @@index([personId])
  @@index([castOrder])
}

model ContentCrew {
  id String @id @default(cuid())

  contentId String
  personId  String

  role CrewRole

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  person  Person  @relation(fields: [personId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contentId, personId, role])
  @@index([contentId])
  @@index([personId])
  @@index([role])
}

model Season {
  id String @id @default(cuid())

  contentId String

  seasonNumber Int

  title String?

  description String? @db.Text

  poster String?

  releaseDate DateTime?

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  episodes Episode[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contentId, seasonNumber])
}

model Episode {
  id String @id @default(cuid())

  seasonId String

  episodeNumber Int

  title String

  description String? @db.Text

  duration Int?

  thumbnail String?

  releaseDate DateTime?

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  videos Video[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([seasonId, episodeNumber])
}

model Video {
  id String @id @default(cuid())

  contentId String?

  episodeId String?

  quality VideoQuality

  url String

  size BigInt?

  duration Int?

  isDefault Boolean @default(false)

  content Content? @relation(fields: [contentId], references: [id], onDelete: Cascade)

  episode Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AudioTrack {
  id String @id @default(cuid())

  contentId String

  languageId String

  label String

  url String

  isDefault Boolean @default(false)

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  language Language @relation(fields: [languageId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subtitle {
  id String @id @default(cuid())

  contentId String

  languageId String

  label String

  url String

  isDefault Boolean @default(false)

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  language Language @relation(fields: [languageId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Image {
  id String @id @default(cuid())

  contentId String

  url String

  alt String?

  sortOrder Int @default(0)

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WatchHistory {
  id String @id @default(cuid())

  userId    String
  contentId String

  watchedDuration Int
  completed       Boolean @default(false)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, contentId])
  @@index([userId])
  @@index([contentId])
}

model ContinueWatching {
  id String @id @default(cuid())

  userId    String
  contentId String

  watchedDuration Int

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, contentId])
  @@index([userId])
  @@index([contentId])
}

model MyList {
  id String @id @default(cuid())

  userId    String
  contentId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, contentId])
  @@index([userId])
  @@index([contentId])
}

model Rating {
  id String @id @default(cuid())

  userId    String
  contentId String

  rating Int

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, contentId])
  @@index([userId])
  @@index([contentId])
}

model Review {
  id String @id @default(cuid())

  userId    String
  contentId String

  title  String?
  review String  @db.Text

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, contentId])
  @@index([userId])
  @@index([contentId])
}

model Notification {
  id String @id @default(cuid())

  userId  String
  type    NotificationType
  title   String
  message String           @db.Text

  isRead Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([isRead])
}

model AuditLog {
  id String @id @default(cuid())

  userId String?

  action   String
  entity   String
  entityId String?

  ipAddress String?
  userAgent String? @db.Text

  metadata Json?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entity])
}
